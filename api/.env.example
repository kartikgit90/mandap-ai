# Copy to .env for local runs. On Cloud Run these come from settings + Secret Manager.

ENV=local
GCP_PROJECT_ID=mandap-ai
GCP_REGION=asia-south1

# Which way we reach Claude:
#   anthropic = Anthropic API directly (works today, needs ANTHROPIC_API_KEY)
#   vertex    = Claude on Google Cloud (once quota is approved)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
